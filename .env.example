# Configuración de Ambiente - COPARMEX

# Modo de ejecución
ENVIRONMENT=production

# API Base URL
API_BASE_URL=https://api.coparmex.com

# Configuración de aplicación
APP_VERSION=1.0.0
APP_NAME=COPARMEX

# Logging
LOGGING_ENABLED=true
LOG_LEVEL=info

# Bases de datos (para futura integración de backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coparmex
DB_USER=admin
DB_PASSWORD=

# Servicios externos
GOOGLE_ANALYTICS_ID=
SENDGRID_API_KEY=
CLOUDINARY_URL=

# Configuración de CORS
CORS_ALLOWED_ORIGINS=https://coparmex.com,https://www.coparmex.com
